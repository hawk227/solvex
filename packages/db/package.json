{
  "name": "@solvex/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply solvex-db --local --persist-to ../../.wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply solvex-db --remote",
    "db:seed:local": "wrangler d1 execute solvex-db --local --persist-to ../../.wrangler/state --file=./src/seed.sql",
    "db:seed:remote": "wrangler d1 execute solvex-db --remote --file=./src/seed.sql",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:studio:local": "wrangler d1 execute solvex-db --local --persist-to ../../.wrangler/state --command",
    "db:demo:local": "wrangler d1 execute solvex-db --local --persist-to ../../.wrangler/state --file=./src/demo-seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.10",
    "wrangler": "^4.115.0"
  }
}
